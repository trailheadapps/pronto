                        "imageInfos": "",
                        "richTextValue": "<div class=\"support-section\">\n    <!-- Section Header -->\n    <h2 class=\"support-section__title\">Need Assistance?</h2>\n    <p class=\"support-section__subtitle\">\n        We're here to help. Choose the support option that works best for you.\n    </p>\n    <!-- Support Options -->\n    <div class=\"support-grid\">\n        <!-- Support Card 1: Live Chat -->\n        <div class=\"support-card\">\n            <div class=\"support-card__header\">Live Chat</div>\n            <div class=\"support-card__body\">\n                Chat with one of our team members for real-time assistance. Get help with account questions, orders, and more.\n            </div>\n            <div class=\"support-card__footer\">\n                <a href=\"/chat\">Start Chat</a>\n            </div>\n        </div>\n        <!-- Support Card 2: Phone Support -->\n        <div class=\"support-card\">\n            <div class=\"support-card__header\">Phone Support</div>\n            <div class=\"support-card__body\">\n                Call us to speak directly with a support specialist. We're here to assist with any complex issues or inquiries.\n            </div>\n            <div class=\"support-card__footer\">\n                <a href=\"/call\">Call Us</a>\n            </div>\n        </div>\n        <!-- Support Card 3: Email Support -->\n        <div class=\"support-card\">\n            <div class=\"support-card__header\">Email Support</div>\n            <div class=\"support-card__body\">\n                Send us an email with your questions or concerns. We'll respond as soon as possible with the answers you need.\n            </div>\n            <div class=\"support-card__footer\">\n                <a href=\"/email\">Email Us</a>\n            </div>\n        </div>\n    </div>\n</div>"

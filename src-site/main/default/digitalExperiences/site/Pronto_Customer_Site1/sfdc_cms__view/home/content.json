                        "imageInfos": "",
                        "richTextValue": "<div class=\"customer-card-section\">\n    <h2 class=\"customer-card-section__title\">How can we help you today?</h2>\n    <p class=\"customer-card-section__subtitle\">Select a category to explore resources and solutions.</p>\n    <div class=\"customer-cards\">\n        <!-- Card 1 -->\n        <div class=\"customer-card\">\n            <div class=\"customer-card__icon\">\n                <img src=\"/sfsites/c/resource/prontosite/pronto-site/track_your_order.png\" alt=\"Order Tracking\">\n            </div>\n            <h3 class=\"customer-card__title\">Track Your Order</h3>\n        </div>\n        <!-- Card 2 -->\n        <div class=\"customer-card\">\n            <div class=\"customer-card__icon\">\n                <img src=\"/sfsites/c/resource/prontosite/pronto-site/refund.png\" alt=\"Refund Requests\">\n            </div>\n            <h3 class=\"customer-card__title\">Refund Requests</h3>\n        </div>\n        <!-- Card 3 -->\n        <div class=\"customer-card\">\n            <div class=\"customer-card__icon\">\n                <img src=\"/sfsites/c/resource/prontosite/pronto-site/customer_support.png\" alt=\"Customer Support\">\n            </div>\n            <h3 class=\"customer-card__title\">Customer Support</h3>\n        </div>\n        <!-- Card 4 -->\n        <div class=\"customer-card\">\n            <div class=\"customer-card__icon\">\n                <img src=\"/sfsites/c/resource/prontosite/pronto-site/delivery_issues.png\" alt=\"Delivery Issues\">\n            </div>\n            <h3 class=\"customer-card__title\">Delivery Issues</h3>\n        </div>\n        <!-- Card 5 -->\n        <div class=\"customer-card\">\n            <div class=\"customer-card__icon\">\n                <img src=\"/sfsites/c/resource/prontosite/pronto-site/account_settings.png\" alt=\"Account Settings\">\n            </div>\n            <h3 class=\"customer-card__title\">Account Settings</h3>\n        </div>\n    </div>\n</div>"

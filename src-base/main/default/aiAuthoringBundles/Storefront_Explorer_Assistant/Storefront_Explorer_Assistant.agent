system:
    instructions: "You are an AI assistant for Pronto, helping customer browse storefronts (restaurants) and menus. Never expose record IDs to the user, use record names instead."

    messages:
        welcome: "Hi, I'm the Pronto storefront explorer assistant. How can I help you?"
        error: "Sorry, it looks like something has gone wrong."

config:
    agent_label: "Storefront Explorer Assistant"
    developer_name: "Storefront_Explorer_Assistant"
    agent_type: "AgentforceServiceAgent"
    description: "Helps Pronto customers browse storefronts and menus."
    enable_enhanced_event_logs: True

access:
    default_agent_user: "%%PRONTO_PLACEHOLDER_AGENT_USERNAME%%"

variables:
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "This variable may also be referred to as MessagingSession Id"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "This variable may also be referred to as MessagingSession EndUserLanguage"
    storefrontId: mutable string = ""
        description: "The record ID of the storefront being used for placing an order or reviewing the menu"
        visibility: "External"
    storefronts: mutable list[object]
        description: "The list of available storefronts"

start_agent agent_router:
    label: "Agent Router"
    description: "Welcome the customer and ask them about their intent"

    reasoning:
        instructions: ->
            | Greet the user and ask them about their intent.
            | Call {!@actions.transition_to_browse_storefronts} when the user wants to browse storefronts, look up a storefront, or check a storefront's opening hours, transition to the browse storefront subagent.
            | Call {!@actions.end_conversation} when the user no longer needs help.

        actions:
            transition_to_browse_storefronts: @utils.transition to @subagent.browse_storefronts
                description: "Call this when the user wants to browse storefronts"

            end_conversation: @utils.end_session

subagent browse_storefronts:
    label: "Browse Storefronts"
    description: "Browse storefronts, look one up by name, and check its operating hours"

    reasoning:
        instructions: ->
            | Help the customer explore Pronto storefronts.
            | Call {!@actions.getStorefronts} to list the available storefronts.
            | Call {!@actions.getStorefrontFromName} when the user names a specific storefront they want details for.
            | Call {!@actions.getStorefrontHours} to retrieve a storefront's operating hours. Use the storefront Id returned by {!@actions.getStorefrontFromName} or {!@actions.getStorefronts}.
            | Call {!@actions.getMenuItems} to retrieve a storefront's available menu items when the user asks about the menu, dishes, or what they can order. Use the storefront Id returned by {!@actions.getStorefrontFromName} or {!@actions.getStorefronts}.
            | Call {!@actions.getCustomerReviews} to retrieve customer reviews for a storefront when asked about reviews, ratings, or customer feedback. Use the storefront Id returned by {!@actions.getStorefrontFromName} or {!@actions.getStorefronts}.
            | After each action, present the returned details directly in your text response using the exact values returned. Do NOT call an action again unless the user asks for new information.
        actions:
            getStorefronts: @actions.getStorefronts
                set @variables.storefronts=@outputs.storefronts
            getStorefrontFromName: @actions.getStorefrontFromName
                with storefrontName=...
                set @variables.storefrontId=@outputs.storefrontId
            getStorefrontHours: @actions.getStorefrontHours
                with storefrontId=...
            getMenuItems: @actions.getMenuItems
                with storefrontId=...
            getCustomerReviews: @actions.getCustomerReviews
                with storefrontId=...

    actions:
        getStorefronts:
            description: "Retrieves the first 10 storefronts"
            inputs:
                recordLimit: integer
                    description: "Optional maximum number of storefronts to return. Defaults to 10."
                    label: "Record Limit"
                    is_required: False
            outputs:
                isSuccess: boolean
                    label: "Is Success"
                message: string
                    label: "Message"
                storefronts: list[object]
                    label: "Storefronts"
                    complex_data_type_name: "lightning__recordInfoType"
            target: "apex://GetStorefrontsAction"
            label: "Get Storefronts"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Retrieving storefronts..."

        getStorefrontFromName:
            description: "Retrieves a storefront record by its name"
            inputs:
                storefrontName: string
                    description: "The name of the storefront to retrieve."
                    label: "Storefront Name"
                    is_required: True
            outputs:
                isSuccess: boolean
                    label: "Is Success"
                message: string
                    label: "Message"
                storefront: object
                    label: "Storefront"
                    complex_data_type_name: "lightning__recordInfoType"
                storefrontId: string
                    description: "The Salesforce record ID of the storefront"
                    label: "Storefront Id"
            target: "apex://GetStorefrontFromNameAction"
            label: "Get Storefront From Name"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Retrieving storefront..."

        getStorefrontHours:
            description: "Retrieves the operating hours for a storefront by its Id"
            inputs:
                storefrontId: string
                    description: "The Salesforce record ID of the storefront whose operating hours are retrieved."
                    label: "Storefront Id"
                    is_required: True
            outputs:
                isSuccess: boolean
                    label: "Is Success"
                message: string
                    label: "Message"
                hours: list[object]
                    label: "Hours of Operation"
                    complex_data_type_name: "lightning__recordInfoType"
            target: "apex://GetStorefrontHoursAction"
            label: "Get Storefront Hours"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Retrieving operating hours..."

        getMenuItems:
            description: "Retrieves the available menu items for a storefront by its Id"
            inputs:
                storefrontId: string
                    description: "The Salesforce record ID of the storefront whose menu items are retrieved."
                    label: "Storefront Id"
                    is_required: True
            outputs:
                isSuccess: boolean
                    label: "Is Success"
                message: string
                    label: "Message"
                menuItems: list[object]
                    label: "Menu Items"
                    complex_data_type_name: "lightning__recordInfoType"
            target: "apex://GetMenuItemsAction"
            label: "Get Menu Items"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Retrieving menu items..."

        getCustomerReviews:
            description: "Retrieves customer reviews for a storefront by its Id"
            inputs:
                storefrontId: string
                    description: "The Salesforce record ID of the storefront whose customer reviews are retrieved."
                    label: "Storefront Id"
                    is_required: True
            outputs:
                isSuccess: boolean
                    label: "Is Success"
                message: string
                    label: "Message"
                reviews: object
                    label: "Reviews"
                    complex_data_type_name: "c__customerReviewsOutput"
                    filter_from_agent: False
                    is_displayable: True
            target: "apex://GetCustomerReviewsAction"
            label: "Get Customer Reviews"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Retrieving customer reviews..."
            source: "Get_Customer_Reviews"

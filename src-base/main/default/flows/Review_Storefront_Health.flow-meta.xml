<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Variables_Assignment</name>
        <label>Variables Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>storefrontName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Storefront.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>averageReviewScore</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Storefront.Average_Review_Score__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>totalReviews</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Storefront.Total_Reviews__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>healthLabel</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>healthLabelFormula</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>healthLabelFormula</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Storefront.Total_Reviews__c}) || {!Get_Storefront.Total_Reviews__c} &lt; 5,
  &quot;Insufficient Data&quot;,
  IF({!Get_Storefront.Average_Review_Score__c} &gt;= 4.5, &quot;Strong&quot;,
    IF({!Get_Storefront.Average_Review_Score__c} &gt;= 4, &quot;Healthy&quot;,
      IF({!Get_Storefront.Average_Review_Score__c} &gt;= 3, &quot;Needs Attention&quot;, &quot;At Risk&quot;)
    )
  )
)</expression>
    </formulas>
    <interviewLabel>Review Storefront Health {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Review Storefront Health</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>

{
  "title": "Customer Reviews Widget",
  "description": "Displays a list of customer reviews with rating, comments, customer name, and order date.",
  "type": "object",
  "properties": {
    "attributes": {
      "lightning:type": "lightning__objectType",
      "properties": {
        "reviewCount": {
          "title": "Review Count",
          "description": "Total number of customer reviews.",
          "lightning:type": "lightning__numberType"
        },
        "averageRating": {
          "title": "Average Rating",
          "description": "Average rating across all customer reviews.",
          "lightning:type": "lightning__numberType"
        },
        "items": {
          "title": "Reviews",
          "description": "List of customer reviews.",
          "lightning:type": "lightning__listType",
          "items": {
            "lightning:type": "@apexClassType/c__GetCustomerReviewsAction$ReviewItemWrapper"
          }
        }
      }
    }
  }
}

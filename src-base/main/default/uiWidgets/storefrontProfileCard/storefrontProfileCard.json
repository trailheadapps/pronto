{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md"
          },
          "children": [
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "md",
                "align": "center",
                "justify": "between"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "name": "building",
                        "size": "sm",
                        "color": "muted",
                        "alt": "Storefront"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.name}",
                        "variant": "h2"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "name": "activity",
                        "size": "sm",
                        "color": "muted",
                        "alt": "Status"
                      }
                    },
                    {
                      "definition": "tile/badge",
                      "attributes": {
                        "label": "{!$attrs.status}",
                        "variant": "{!$attrs.statusVariant}"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "sm"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "name": "tag",
                        "size": "sm",
                        "color": "muted",
                        "alt": "Cuisine"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Cuisine",
                        "variant": "body",
                        "weight": "semibold",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.cuisine}",
                        "variant": "body"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "name": "star",
                        "size": "sm",
                        "color": "muted",
                        "alt": "Rating"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Rating",
                        "variant": "body",
                        "weight": "semibold",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.ratingLabel}",
                        "variant": "body"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "name": "map-pin",
                        "size": "sm",
                        "color": "muted",
                        "alt": "Address"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Address",
                        "variant": "body",
                        "weight": "semibold",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.address}",
                        "variant": "body"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "name": "phone",
                        "size": "sm",
                        "color": "muted",
                        "alt": "Phone"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Phone",
                        "variant": "body",
                        "weight": "semibold",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.phone}",
                        "variant": "body"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "sm",
                "align": "center"
              },
              "children": [
                {
                  "definition": "tile/button",
                  "attributes": {
                    "label": "View Menu",
                    "variant": "primary",
                    "iconName": "list",
                    "actions": {
                      "click": [
                        {
                          "definition": "action/sendMessage",
                          "attributes": {
                            "content": "{!'Show me the menu for ' & $attrs.name}"
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "definition": "tile/button",
                  "attributes": {
                    "label": "Check Hours",
                    "variant": "secondary",
                    "iconName": "clock",
                    "actions": {
                      "click": [
                        {
                          "definition": "action/sendMessage",
                          "attributes": {
                            "content": "{!'What are the hours for ' & $attrs.name & '?'}"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}

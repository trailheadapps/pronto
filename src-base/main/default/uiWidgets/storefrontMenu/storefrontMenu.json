{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "lg"
          },
          "children": [
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "xs"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "name": "list",
                        "size": "sm",
                        "color": "muted",
                        "alt": "Menu"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Menu",
                        "variant": "h2"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.storefrontName} · {!$attrs.summaryLabel}",
                    "variant": "caption",
                    "color": "muted"
                  }
                }
              ]
            },
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "sm"
              },
              "meta": {
                "forEach": "{!$attrs.items}",
                "forItem": "$item"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "md",
                    "align": "center",
                    "justify": "between"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$item.name}",
                        "variant": "h4",
                        "weight": "semibold"
                      }
                    },
                    {
                      "definition": "tile/badge",
                      "attributes": {
                        "label": "{!$item.priceLabel}",
                        "variant": "info"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$item.description}",
                    "variant": "body",
                    "color": "muted"
                  }
                },
                {
                  "definition": "tile/separator",
                  "attributes": {
                    "orientation": "horizontal"
                  }
                }
              ]
            },
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "sm",
                "align": "center"
              },
              "children": [
                {
                  "definition": "tile/button",
                  "attributes": {
                    "label": "Back to Storefront",
                    "variant": "primary",
                    "iconName": "building",
                    "actions": {
                      "click": [
                        {
                          "definition": "action/sendMessage",
                          "attributes": {
                            "content": "{!'Tell me about ' & $attrs.storefrontName}"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
